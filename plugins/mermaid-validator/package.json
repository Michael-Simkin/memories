{
  "name": "mermaid-validator-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Validate mermaid diagrams in markdown files via PostToolUse hook",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "happy-dom": "^20.9.0",
    "mermaid": "^11.15.0",
    "zod": "^4.1.12"
  }
}
